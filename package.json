{
  "name": "rcube-html",
  "version": "0.2.0",
  "description": "Schema-driven React + Bootstrap forms and layouts: validation, conditional fields, dependent selects, repeatable entries, runtime element changes and i18n.",
  "keywords": [
    "react",
    "react-bootstrap",
    "bootstrap",
    "form",
    "schema",
    "form-builder",
    "validation",
    "i18n",
    "nextjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcubesystem/rcube-html.git"
  },
  "homepage": "https://github.com/rcubesystem/rcube-html#readme",
  "bugs": {
    "url": "https://github.com/rcubesystem/rcube-html/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lang/*": {
      "import": "./dist/lang/*.js",
      "require": "./dist/lang/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "bootstrap": ">=5.3",
    "react": ">=18",
    "react-bootstrap": ">=2.10",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "bootstrap": "5.3.3",
    "react": "18.3.1",
    "react-bootstrap": "2.10.10",
    "react-dom": "18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  }
}
