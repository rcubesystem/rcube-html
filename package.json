{
  "name": "rcube-html",
  "version": "0.7.0",
  "description": "Schema-driven React forms and layouts with their own components and stylesheet (no Bootstrap needed): validation, conditional fields, dependent selects, repeatable entries, tables, charts, calendar, tree, uploads, runtime element changes and i18n.",
  "keywords": [
    "react",
    "form",
    "schema",
    "form-builder",
    "validation",
    "i18n",
    "nextjs",
    "liferay",
    "datatable"
  ],
  "license": "MIT",
  "author": "Riyaz Hameed <riyaz.mohamed@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcubesystem/rcube-html.git"
  },
  "homepage": "https://github.com/rcubesystem/rcube-html#readme",
  "bugs": {
    "url": "https://github.com/rcubesystem/rcube-html/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./lang/*": {
      "import": "./dist/lang/*.js",
      "require": "./dist/lang/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build-styles.mjs && tsup",
    "dev": "node scripts/build-styles.mjs && tsup --watch",
    "styles": "node scripts/build-styles.mjs",
    "prepublishOnly": "npm run build",
    "test": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  }
}
